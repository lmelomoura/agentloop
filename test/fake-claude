#!/usr/bin/env bash
# A stand-in for the Claude Code CLI, emitting the stream-json shape the engine
# parses. It exists so the session lifecycle can be driven end to end without
# spending a real session on it — everything here is ours except the model.
#
# WHAT A GREEN E2E RUN DOES *NOT* PROVE. Every behaviour below is steered by env
# vars. Unless FAKE_ARGV_OUT is set this stand-in never looks at "$@" at all, so
# it accepts ANY launch line and reports success either way — a green suite is
# not evidence about the arguments run_job builds. It cost a Critical: a variadic
# `--disallowedTools` at the end of the launch swallowed the prompt positional,
# the real CLI died with "Input must be provided ... when using --print" before
# its first turn, and this suite stayed green throughout because it never read an
# argv. Set FAKE_ARGV_OUT to record one (see scenario 12 in e2e.test.sh), and
# never cite a green run here as proof that the launch path is sound.
#
# Behaviour is steered by env vars the harness sets:
#   FAKE_SESSION  the session id to report in the init event
#   FAKE_MODE     complete | undeclared | dirty | hang | silent
#   FAKE_SKIP_PREPARE  set to skip `security prepare` inside a security run
#                      that is NOT a unit (a hand launch); a unit never runs
#                      it -- its orchestrator did, once, engine-side
#   AL_SECURITY_UNIT_ID  set by the engine on a unit of a security analysis:
#                      the stand-in then plays that unit (test/fake-unit.sh,
#                      which also documents FAKE_READ_NOTHING,
#                      FAKE_SKIP_READ_ONCE and FAKE_HUNT_FINDING)
#   FAKE_ARGV_OUT      a path to record the launch argv in, one line per
#                      ARGUMENT, "<n><TAB><that argument's first line>"
#   FAKE_ACCOUNT_OUT   a path to record the account this launch signs in as
#                      (CLAUDE_CONFIG_DIR, empty line when it has none) — the
#                      one fact the argv cannot show, since it travels in the
#                      environment
#   FAKE_CWD_OUT       a path to record where this launch runs, one
#                      "<key><TAB><value>" line each: PWD, the HEAD commit
#                      checked out there, and the run's MANIFEST
#                      ($AL_RUN_MANIFEST, on one line)
#   FAKE_PID_OUT       a path to record this process's own pid in -- the
#                      CLI's, which is what a stop and the watchdog have to
#                      reach (see scenario 53 in e2e.test.sh)
#   FAKE_CLAUDE_LOGGED_OUT  set to play a CLI with no session: `auth status` exits 1,
#                      and in the probe world below every model probe gets the
#                      CLI's not-logged-in answer
#   FAKE_KILLED_USAGE  set to emit two assistant "turns" carrying real usage,
#                      each repeated twice under the SAME message id (the
#                      shape a real killed run's stream has -- one line per
#                      content block, all carrying that turn's cumulative
#                      usage) -- for a mode that then ends with no result
#                      event (hang, killed by the watchdog or a stop): proves
#                      run_job's salvage path estimates that run's cost from
#                      the stream instead of recording it lost as $0.00
#   FAKE_RATE_LIMIT_EVENT  set to emit one rate_limit_event line into the
#                      stream, shaped like the real one (see the fixture in
#                      test/selftest.sh's rate-limits block): status
#                      allowed_warning, rateLimitType seven_day, utilization
#                      0.98. rl_capture reads it off the account's own stream,
#                      whichever account's directory this launch ran with.
#   $CLAUDE_CONFIG_DIR/.fake-logged-out  that one directory has no session (an account signed out)
#   $CLAUDE_CONFIG_DIR/.fake-email       the email `auth status` names for that directory
#   FAKE_CLAUDE_VERSION  the build this stand-in plays (default 2.1.258): what
#                      `--version` prints and the build the 400 below names
#
# The model probes resolve_family makes (a world of its own, off unless
# FAKE_API_MODELS is set, so every other suite keeps the launch path below):
#   FAKE_API_MODELS    the ids the API serves to this CLI build, space-separated
#   FAKE_GATED_MODELS  the ids it serves only to a newer build: the answer is
#                      the API's 400, naming the version required
#   FAKE_FAILED_MODELS the ids whose probe gets no verdict at all: the answer is
#                      the CLI's not-logged-in one, as if the session went
#                      mid-pass
#   FAKE_CLI_MODELS    the ids this CLI build recognises; a request for any
#                      other id also writes the CLI's unrecognized-model line
#                      to stderr, whatever the answer, as the real one does
#   FAKE_ALIASES       what each family alias points at in this build, as
#                      family=id pairs (read by model_alias_baseline)
#   FAKE_PROBE_LOG     a path to append every probed id to, one per line
set -u

# The two probes platform_check makes BEFORE a launch. Answered here, before
# any recording below, so a FAKE_ARGV_OUT/FAKE_ACCOUNT_OUT set for the launch
# never captures the probe instead of the run.
case "${1:-}" in
  --version) echo "${FAKE_CLAUDE_VERSION:-2.1.258} (Claude Code)"; exit 0 ;;
  auth)
    # One session per config directory, the way the real CLI keeps them: a
    # directory holding .fake-logged-out has none, and .fake-email names the
    # account signed in there.
    if [ -n "${FAKE_CLAUDE_LOGGED_OUT:-}" ] || { [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ -f "$CLAUDE_CONFIG_DIR/.fake-logged-out" ]; }; then
      printf '{"loggedIn":false,"authMethod":"none"}\n'; exit 1
    fi
    email="fake@example.org"
    if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ -f "$CLAUDE_CONFIG_DIR/.fake-email" ]; then email="$(cat "$CLAUDE_CONFIG_DIR/.fake-email")"; fi
    printf '{"loggedIn":true,"authMethod":"claude.ai","email":"%s","subscriptionType":"max"}\n' "$email"; exit 0 ;;
esac

# THE MODEL PROBES, answered from real captures: the 404 and its stderr line
# are CLI 2.1.280's answer to an id the API does not serve
# (fixtures/claude-probe-unknown-model.*), the 400 is 2.1.258's answer to
# Opus 5.5, which the API served only to 2.1.280 or newer
# (fixtures/claude-probe-version-gated.*), the not-logged-in answer is
# 2.1.280's with no USER in its environment, when it cannot find its
# keychain credential (fixtures/claude-probe-not-logged-in.*: exit 1, $0, and
# the same stderr line for an id it does not know), and the accepted result
# and the alias's init event come from the 2.1.258 probe in
# fixtures/stream-json-hooked-probe.ndjson. A CLI with no session still names
# its alias's model in that init event (measured), so the baseline below is
# the same logged in or not. Arguments are read in place, not shifted, so
# anything this branch does not answer falls through untouched.
if [ -n "${FAKE_API_MODELS:-}" ]; then
  fx="$(cd "$(dirname "$0")" && pwd)/fixtures"
  fmt="" model="" prev=""
  for a in "$@"; do
    case "$prev" in --output-format) fmt="$a" ;; --model) model="$a" ;; esac
    prev="$a"
  done
  case "$fmt" in
    stream-json)            # model_alias_baseline: the init event names the alias's id
      target=""
      for pair in ${FAKE_ALIASES:-}; do
        [ "${pair%%=*}" = "$model" ] && target="${pair#*=}"
      done
      sed "s/\"model\":\"[^\"]*\"/\"model\":\"$target\"/" "$fx/stream-json-hooked-probe.ndjson"
      exit 0 ;;
    json)                   # model_probe_ok
      [ -n "${FAKE_PROBE_LOG:-}" ] && printf '%s\n' "$model" >> "$FAKE_PROBE_LOG"
      # Which answer this id gets, when it is not served: no verdict at all
      # without a session (served or not, the id is never asked about), the
      # 400 of a newer build's model, or the 404 of an unknown one.
      refusal=claude-probe-unknown-model
      case " ${FAKE_GATED_MODELS:-} " in *" $model "*) refusal=claude-probe-version-gated ;; esac
      case " ${FAKE_FAILED_MODELS:-} " in *" $model "*) refusal=claude-probe-not-logged-in ;; esac
      [ -z "${FAKE_CLAUDE_LOGGED_OUT:-}" ] || refusal=claude-probe-not-logged-in
      # The id each capture was taken for, swapped for the one probed here.
      # Read from the capture rather than written out: the server and the
      # engine scan the CLI binary for ids, and this file stands in for it.
      was="$(sed -n 's/.*"model":"\([^"]*\)".*/\1/p' "$fx/$refusal.stderr")"
      case " ${FAKE_CLI_MODELS:-} " in
        *" $model "*) ;;
        *) sed "s/$was/$model/" "$fx/$refusal.stderr" >&2 ;;
      esac
      if [ "$refusal" != claude-probe-not-logged-in ]; then
        case " $FAKE_API_MODELS " in
          *" $model "*) grep '"type":"result"' "$fx/stream-json-hooked-probe.ndjson"; exit 0 ;;
        esac
      fi
      # The 400 names the build that asked: 2.1.258 in the capture.
      sed -e "s/$was/$model/" -e "s/Claude Code 2\.1\.258 does not/Claude Code ${FAKE_CLAUDE_VERSION:-2.1.258} does not/" "$fx/$refusal.json"
      exit 1 ;;
  esac
fi

if [ -n "${FAKE_ACCOUNT_OUT:-}" ]; then
  printf '%s\n' "${CLAUDE_CONFIG_DIR:-}" > "$FAKE_ACCOUNT_OUT"
fi

# The CLI's own pid, from the CLI's side: the engine records the pid it will
# signal on a stop, and the two are only the same process when the launch
# hands the CLI that pid instead of forking it under a shell.
[ -z "${FAKE_PID_OUT:-}" ] || printf '%s\n' "$$" > "$FAKE_PID_OUT"

# Where the engine put the agent, read from the agent's own side: its working
# directory is the tree `prepare` and every tool call read, and neither the
# argv nor the account says which tree that is. Written before `prepare` and
# the stream, so a run that fails later still leaves the answer behind.
if [ -n "${FAKE_CWD_OUT:-}" ]; then
  { printf 'PWD\t%s\n' "$PWD"
    printf 'HEAD\t%s\n' "$(git rev-parse HEAD 2>/dev/null)"
    printf 'MANIFEST\t%s\n' "$(jq -c . "${AL_RUN_MANIFEST:-/dev/null}" 2>/dev/null)"
  } > "$FAKE_CWD_OUT"
fi

# The one place this file reads its own arguments. First line only, because the
# prompt is a paragraph — but one line here is still exactly one argument there,
# which is what makes the recording worth reading.
# Written whole and then moved into place: the units of one analysis launch
# side by side, and two stand-ins truncating one file at once would leave
# neither launch line readable. The last to finish is the one recorded.
if [ -n "${FAKE_ARGV_OUT:-}" ]; then
  { printf 'ARGC\t%s\n' "$#"
    n=0
    for a in "$@"; do n=$((n + 1)); printf '%s\t%s\n' "$n" "${a%%$'\n'*}"; done
  } > "$FAKE_ARGV_OUT.$$" && mv -f "$FAKE_ARGV_OUT.$$" "$FAKE_ARGV_OUT"
fi

sid="${FAKE_SESSION:-sess-fake-0001}"
mode="${FAKE_MODE:-complete}"
# The `--model` this launch asked for (run_job's own -- see run_job's
# `args="... --model $model ..."`), echoed into the init event below exactly
# as a real session does: the engine reads it back (run_job's model_id) to
# price a killed run's estimate against the right row of config/pricing.json.
model=""; prev=""
for a in "$@"; do
  [ "$prev" = "--model" ] && model="$a"
  prev="$a"
done

# A UNIT OF A SECURITY ANALYSIS (security/orchestrator.py). The prompt is the
# last argument (after `--`). The ledger side is test/fake-unit.sh's; the
# reading is this CLI's own: a Read of every range the prompt lists, with the
# result shape Claude Code writes (`tool_use_result.file`), which is what the
# proof of reading counts (security/evidence.py).
. "$(dirname "$0")/fake-unit.sh"
fake_unit_init "${!#}"
FAKE_UNIT_EVENTS=""
# A read unit reads its own RANGES; a triage unit reads only what it needs to
# prove a [carried] sast row gone (fake_unit_triage_gone_specs) -- both
# shapes are "path:first-last" per line, and both get the same Read events.
case "$FAKE_UNIT_KIND" in
  read)   FAKE_UNIT_SPECS="$(fake_unit_ranges)" ;;
  triage) FAKE_UNIT_SPECS="$(fake_unit_triage_gone_specs)" ;;
  *)      FAKE_UNIT_SPECS="" ;;
esac
if [ -n "$FAKE_UNIT_SPECS" ]; then
  n=0
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    n=$((n + 1)); path="${spec%:*}"; span="${spec##*:}"; first="${span%-*}"; last="${span#*-}"
    FAKE_UNIT_EVENTS="$FAKE_UNIT_EVENTS$(jq -nc --arg id "r$n" --arg p "$PWD/$path" \
      '{type:"assistant",parent_tool_use_id:null,message:{content:[{type:"tool_use",id:$id,name:"Read",input:{file_path:$p}}]}}')
$(jq -nc --arg id "r$n" --arg p "$PWD/$path" --argjson a "$first" --argjson b "$last" \
      '{type:"user",parent_tool_use_id:null,message:{content:[{type:"tool_result",tool_use_id:$id,content:""}]},tool_use_result:{type:"text",file:{filePath:$p,startLine:$a,numLines:($b-$a+1),totalLines:$b}}}')
"
  done <<EOF
$FAKE_UNIT_SPECS
EOF
fi
fake_unit_act

# A SECURITY RUN'S FIRST COMMAND, before the pipeline: a security run that is
# not a unit (a hand launch of the stand-in) still plays the agent that ran
# `security prepare` itself. A unit never does -- its orchestrator prepared
# the analysis once, engine-side, before any unit was launched.
if [ -n "${AL_SECURITY_ANALYSIS_ID:-}" ] && [ -z "${AL_SECURITY_UNIT_ID:-}" ] && [ -z "${FAKE_SKIP_PREPARE:-}" ]; then
  "$(cd "$(dirname "$0")/../bin" && pwd)/agentloop" security prepare \
    --analysis "$AL_SECURITY_ANALYSIS_ID" --root "$PWD" --offline >/dev/null 2>&1 || true
fi

# `silent`: never write a byte, then sleep -- the shape of a CLI whose
# provider never answered, or of a resume that a CLI took to another
# directory (both measured on OpenCode). `exec` so the engine's TERM ends it.
[ "$mode" != "silent" ] || exec sleep 600

# The init event, deliberately fat: a real one carries the whole tool roster,
# which is what used to overflow an 8 KB read on both sides.
{
  # `cwd`, as the real one carries it: the orchestrator judges a unit whose
  # run died unclosed from its stream, relative to this root.
  printf '{"type":"system","subtype":"init","session_id":"%s","cwd":"%s","tools":[' "$sid" "$PWD"
  i=0
  while [ "$i" -lt 400 ]; do
    [ "$i" -gt 0 ] && printf ','
    printf '"a-tool-with-a-fairly-long-name-%s"' "$i"
    i=$((i + 1))
  done
  printf '],"model":"%s"}\n' "$model"
}

printf '{"type":"assistant","message":{"content":[{"type":"text","text":"working"}]}}\n'
[ -z "$FAKE_UNIT_EVENTS" ] || printf '%s' "$FAKE_UNIT_EVENTS"

if [ -n "${FAKE_KILLED_USAGE:-}" ]; then
  printf '{"type":"assistant","message":{"id":"msg_turn_a","usage":{"input_tokens":2,"cache_creation_input_tokens":1000,"cache_read_input_tokens":500,"output_tokens":5}}}\n'
  printf '{"type":"assistant","message":{"id":"msg_turn_a","usage":{"input_tokens":2,"cache_creation_input_tokens":1000,"cache_read_input_tokens":500,"output_tokens":5}}}\n'
  printf '{"type":"assistant","message":{"id":"msg_turn_b","usage":{"input_tokens":3,"cache_creation_input_tokens":0,"cache_read_input_tokens":2000,"output_tokens":45}}}\n'
  printf '{"type":"assistant","message":{"id":"msg_turn_b","usage":{"input_tokens":3,"cache_creation_input_tokens":0,"cache_read_input_tokens":2000,"output_tokens":45}}}\n'
fi

[ -z "${FAKE_RATE_LIMIT_EVENT:-}" ] || printf '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed_warning","resetsAt":1785427200,"rateLimitType":"seven_day","utilization":0.98,"surpassedThreshold":0.75}}\n'

case "$mode" in
  dirty)
    # Leave work in the tree that exists on no remote, and still declare a
    # clean ending — the shape that used to be filed away in a folder.
    echo "the agent was here" > agent-left-this.txt
    result="RUN COMPLETE: made a change and did not push it."
    ;;
  undeclared)
    # Stop without saying how it ended: the signature of a run cut off.
    result="I did some work."
    ;;
  hang)
    # `exec`, as `silent` does above: the process the engine signals has to
    # be the one that ends. A bash waiting on a foreground `sleep` dies of
    # the TERM and leaves the sleep behind, orphaned, for ten minutes.
    exec sleep 600
    ;;
  *)
    result="RUN COMPLETE: nothing needed doing."
    ;;
esac

printf '{"type":"result","subtype":"success","is_error":false,"num_turns":2,"session_id":"%s","total_cost_usd":0,"result":"%s"}\n' \
  "$sid" "$result"
