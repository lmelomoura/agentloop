#!/usr/bin/env bash
# A stand-in for the Claude Code CLI, emitting the stream-json shape the engine
# parses. It exists so the session lifecycle can be driven end to end without
# spending a real session on it — everything here is ours except the model.
#
# WHAT A GREEN E2E RUN DOES *NOT* PROVE. Every behaviour below is steered by env
# vars. Unless FAKE_ARGV_OUT is set this stand-in never looks at "$@" at all, so
# it accepts ANY launch line and reports success either way — a green suite is
# not evidence about the arguments run_job builds. It cost a Critical: a variadic
# `--disallowedTools` at the end of the launch swallowed the prompt positional,
# the real CLI died with "Input must be provided ... when using --print" before
# its first turn, and this suite stayed green throughout because it never read an
# argv. Set FAKE_ARGV_OUT to record one (see scenario 12 in e2e.test.sh), and
# never cite a green run here as proof that the launch path is sound.
#
# Behaviour is steered by env vars the harness sets:
#   FAKE_SESSION  the session id to report in the init event
#   FAKE_MODE     complete | undeclared | dirty | hang | silent
#   FAKE_SKIP_PREPARE  set to skip `security prepare` inside a security run,
#                      i.e. to play the agent that ignored its first command
#   FAKE_ARGV_OUT      a path to record the launch argv in, one line per
#                      ARGUMENT, "<n><TAB><that argument's first line>"
#   FAKE_ACCOUNT_OUT   a path to record the account this launch signs in as
#                      (CLAUDE_CONFIG_DIR, empty line when it has none) — the
#                      one fact the argv cannot show, since it travels in the
#                      environment
#   FAKE_CLAUDE_LOGGED_OUT  set to play a CLI with no session: `auth status` exits 1
#
# The model probes resolve_family makes (a world of its own, off unless
# FAKE_API_MODELS is set, so every other suite keeps the launch path below):
#   FAKE_API_MODELS    the ids the API serves to this CLI build, space-separated
#   FAKE_GATED_MODELS  the ids it serves only to a newer build: the answer is
#                      the API's 400, naming the version required
#   FAKE_CLI_MODELS    the ids this CLI build recognises; a request for any
#                      other id also writes the CLI's unrecognized-model line
#                      to stderr, whatever the answer, as the real one does
#   FAKE_ALIASES       what each family alias points at in this build, as
#                      family=id pairs (read by model_alias_baseline)
#   FAKE_PROBE_LOG     a path to append every probed id to, one per line
set -u

# The two probes platform_check makes BEFORE a launch. Answered here, before
# any recording below, so a FAKE_ARGV_OUT/FAKE_ACCOUNT_OUT set for the launch
# never captures the probe instead of the run.
case "${1:-}" in
  --version) echo "2.1.258 (Claude Code)"; exit 0 ;;
  auth)
    if [ -n "${FAKE_CLAUDE_LOGGED_OUT:-}" ]; then
      printf '{"loggedIn":false,"authMethod":"none"}\n'; exit 1
    fi
    printf '{"loggedIn":true,"authMethod":"claude.ai","email":"fake@example.org","subscriptionType":"max"}\n'; exit 0 ;;
esac

# THE MODEL PROBES, answered from real captures: the 404 and its stderr line
# are CLI 2.1.280's answer to an id the API does not serve
# (fixtures/claude-probe-unknown-model.*), the 400 is 2.1.258's answer to
# Opus 5.5, which the API served only to 2.1.280 or newer
# (fixtures/claude-probe-version-gated.*), and the accepted result and the
# alias's init event come from the 2.1.258 probe in
# fixtures/stream-json-hooked-probe.ndjson. Arguments are read in place, not
# shifted, so anything this branch does not answer falls through untouched.
if [ -n "${FAKE_API_MODELS:-}" ]; then
  fx="$(cd "$(dirname "$0")" && pwd)/fixtures"
  fmt="" model="" prev=""
  for a in "$@"; do
    case "$prev" in --output-format) fmt="$a" ;; --model) model="$a" ;; esac
    prev="$a"
  done
  case "$fmt" in
    stream-json)            # model_alias_baseline: the init event names the alias's id
      target=""
      for pair in ${FAKE_ALIASES:-}; do
        [ "${pair%%=*}" = "$model" ] && target="${pair#*=}"
      done
      sed "s/\"model\":\"[^\"]*\"/\"model\":\"$target\"/" "$fx/stream-json-hooked-probe.ndjson"
      exit 0 ;;
    json)                   # model_probe_ok
      [ -n "${FAKE_PROBE_LOG:-}" ] && printf '%s\n' "$model" >> "$FAKE_PROBE_LOG"
      # Which refusal this id gets, when it is not served: the 400 of a
      # newer build's model, or the 404 of an unknown one.
      refusal=claude-probe-unknown-model
      case " ${FAKE_GATED_MODELS:-} " in *" $model "*) refusal=claude-probe-version-gated ;; esac
      # The id each capture was taken for, swapped for the one probed here.
      # Read from the capture rather than written out: the server and the
      # engine scan the CLI binary for ids, and this file stands in for it.
      was="$(sed -n 's/.*"model":"\([^"]*\)".*/\1/p' "$fx/$refusal.stderr")"
      case " ${FAKE_CLI_MODELS:-} " in
        *" $model "*) ;;
        *) sed "s/$was/$model/" "$fx/$refusal.stderr" >&2 ;;
      esac
      case " $FAKE_API_MODELS " in
        *" $model "*) grep '"type":"result"' "$fx/stream-json-hooked-probe.ndjson"; exit 0 ;;
      esac
      sed "s/$was/$model/" "$fx/$refusal.json"
      exit 1 ;;
  esac
fi

if [ -n "${FAKE_ACCOUNT_OUT:-}" ]; then
  printf '%s\n' "${CLAUDE_CONFIG_DIR:-}" > "$FAKE_ACCOUNT_OUT"
fi

# The one place this file reads its own arguments. First line only, because the
# prompt is a paragraph — but one line here is still exactly one argument there,
# which is what makes the recording worth reading.
if [ -n "${FAKE_ARGV_OUT:-}" ]; then
  { printf 'ARGC\t%s\n' "$#"
    n=0
    for a in "$@"; do n=$((n + 1)); printf '%s\t%s\n' "$n" "${a%%$'\n'*}"; done
  } > "$FAKE_ARGV_OUT"
fi

sid="${FAKE_SESSION:-sess-fake-0001}"
mode="${FAKE_MODE:-complete}"

# A SECURITY RUN'S FIRST COMMAND. The real agent is told to run this by the
# analysis prompt and by skills/security-analysis/SKILL.md, and the engine
# refuses to close an analysis `done` without it -- so a stand-in that never
# ran it would only ever exercise that refusal, never the happy path.
# AL_SECURITY_ANALYSIS_ID is exported into the run by cmd_security_analyze and
# is the one signal here that this is an analysis rather than an ordinary job.
if [ -n "${AL_SECURITY_ANALYSIS_ID:-}" ] && [ -z "${FAKE_SKIP_PREPARE:-}" ]; then
  "$(cd "$(dirname "$0")/../bin" && pwd)/agentloop" security prepare \
    --analysis "$AL_SECURITY_ANALYSIS_ID" --root "$PWD" --offline >/dev/null 2>&1 || true
fi

# `silent`: never write a byte, then sleep -- the shape of a CLI whose
# provider never answered, or of a resume that a CLI took to another
# directory (both measured on OpenCode). `exec` so the engine's TERM ends it.
[ "$mode" != "silent" ] || exec sleep 600

# The init event, deliberately fat: a real one carries the whole tool roster,
# which is what used to overflow an 8 KB read on both sides.
{
  printf '{"type":"system","subtype":"init","session_id":"%s","tools":[' "$sid"
  i=0
  while [ "$i" -lt 400 ]; do
    [ "$i" -gt 0 ] && printf ','
    printf '"a-tool-with-a-fairly-long-name-%s"' "$i"
    i=$((i + 1))
  done
  printf ']}\n'
}

printf '{"type":"assistant","message":{"content":[{"type":"text","text":"working"}]}}\n'

case "$mode" in
  dirty)
    # Leave work in the tree that exists on no remote, and still declare a
    # clean ending — the shape that used to be filed away in a folder.
    echo "the agent was here" > agent-left-this.txt
    result="RUN COMPLETE: made a change and did not push it."
    ;;
  undeclared)
    # Stop without saying how it ended: the signature of a run cut off.
    result="I did some work."
    ;;
  hang)
    sleep 600
    result="never reached"
    ;;
  *)
    result="RUN COMPLETE: nothing needed doing."
    ;;
esac

printf '{"type":"result","subtype":"success","is_error":false,"num_turns":2,"session_id":"%s","total_cost_usd":0,"result":"%s"}\n' \
  "$sid" "$result"
